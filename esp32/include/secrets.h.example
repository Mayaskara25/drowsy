// Copy to secrets.h and edit — gitignored, never commit.
// See docs/hardware.md §3 for modes. This file is optional; without it the firmware
// falls back to demo AP DRIVER-CAM / drowsy123 (bench mode, no router).
#pragma once

// Direct demo AP (preferred first, §18) — phone joins ESP32 AP, no router.
#define AP_SSID "DRIVER-CAM"
#define AP_PASS "drowsy123"   // change for your bench; 8+ chars, WPA2
#define AP_CHANNEL 6
#define AP_MAX_CLIENTS 4

// Existing network / phone hotspot (later, §18) — set to 0 to stay AP-only.
#define USE_STA 0
#define STA_SSID "your-hotspot-ssid"
#define STA_PASS "your-hotspot-pass"

// Optional: protect /stream with token query ?token=...
//#define STREAM_TOKEN "change-me-32chars"
